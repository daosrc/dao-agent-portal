{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "qiniu": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Qiniu AI",
      "options": {
        "baseURL": "https://api.qnaigc.com/v1",
        "apiKey": "{{QINIU_API_KEY}}"
      },
      "models": {
        "google/gemini-3.1-flash-lite-image": {
          "name": "Gemini 3.1 Flash Lite Image (Qiniu)",
          "id": "google/gemini-3.1-flash-lite-image",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text", "image"]
          }
        },
        "claude-4.5-sonnet": {
          "name": "Claude 4.5 Sonnet (Qiniu)",
          "id": "qiniu-ai/claude-4.5-sonnet",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text", "image"]
          }
        },
        "claude-4.6-sonnet": {
          "name": "Claude 4.6 Sonnet (Qiniu)",
          "id": "claude-4.6-sonnet",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text", "image"]
          }
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (Qiniu)",
          "id": "deepseek/deepseek-v4-flash"
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro (Qiniu)",
          "id": "deepseek/deepseek-v4-pro"
        },
        "deepseek-v4-pro-202606": {
          "name": "DeepSeek V4 Pro 202606 (Qiniu)",
          "id": "deepseek/deepseek-v4-pro-202606",
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "claude-4.7-opus": {
          "name": "Claude 4.7 Opus (Qiniu)",
          "id": "anthropic/claude-4.7-opus",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text", "image"]
          }
        },
        "claude-4.8-opus": {
          "name": "Claude 4.8 Opus (Qiniu)",
          "id": "anthropic/claude-4.8-opus",
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "z-ai-glm-5.2": {
          "name": "GLM 5.2 (Qiniu)",
          "id": "z-ai/glm-5.2"
        },
        "kling-3.0-turbo": {
          "name": "Kling 3.0 Turbo (Qiniu)",
          "id": "kling-video/kling-3.0-turbo",
          "modalities": {
            "input": ["text", "image"],
            "output": ["video"]
          }
        },
        "viduq3": {
          "name": "Vidu Q3 (Qiniu)",
          "id": "vidu/viduq3",
          "modalities": {
            "input": ["text", "image", "video"],
            "output": ["video"]
          }
        },
        "viduq3-pro": {
          "name": "Vidu Q3 Pro (Qiniu)",
          "id": "viduq3-pro",
          "modalities": {
            "input": ["text", "image", "video"],
            "output": ["video"]
          }
        }
      }
    },
    "agnes": {
      "name": "Agnes",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://apihub.agnes-ai.com/v1"
      },
      "models": {
        "agnes-2.0-flash": {
          "name": "Agnes 2.0 Flash"
        },
        "agnes-image-2.0-flash": {
          "name": "Agnes  Image 2.0 Flash"
        },
        "agnes-image-2.1-flash": {
          "name": "Agnes  Image 2.1 Flash"
        }
      }
    }
  },
  "instructions": [
    "~/.config/opencode/memory-instructions.md"
  ],
  "skills": {
    "paths": [
      "../shared/skills"
    ]
  },
  "plugin": [
    "./plugins/agentmemory-capture.ts"
  ],
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "agentmemory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@agentmemory/mcp"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{{CONTEXT7_API_KEY}}"
      }
    }
  },
  "disabled_providers": []
}
